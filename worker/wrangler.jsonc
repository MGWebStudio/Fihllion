// The answer counter and AI referee. See the "Answer counts" and "AI referee" sections of the main README.
{
  "name": "fihllion-counts",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fihllion",
      "database_id": "b600079c-daa2-43f3-9a5b-6051ca3b5948",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  // The PC referee's connection (src/pc.js). Free-plan Durable Objects have to be SQLite-backed.
  "durable_objects": { "bindings": [{ "name": "PC", "class_name": "PcLink" }] },
  "migrations": [{ "tag": "pc-v1", "new_sqlite_classes": ["PcLink"] }],
  "vars": {
    "DATA_URL": "https://mgwebstudio.github.io/Fihllion/data/",
    "ALLOWED_ORIGINS": "https://mgwebstudio.github.io",
    // The referee's daily AI budget in Cloudflare's units ("neurons"), out of 10,000 free a day.
    // A call costs about 2.4, so this is about 4,000 calls. Practice stops AI_RANKED_RESERVE units
    // sooner, keeping about 800 calls for ranked. See the top of worker/src/shared.js.
    "AI_DAILY_UNITS": "9800",
    "AI_RANKED_RESERVE": "2000",
    // When players start getting asked to put in their real name or go anonymous, and need to answer
    // before a ranked Daily: Friday Nov 20, 2026 at midnight Mountain Time. See needsName in src/ranked.js.
    "NAMES_FROM": "2026-11-20T07:00:00Z",
    // Which referee checks try the PC referee first (src/pc.js, pc-referee/): "practice" (Endless,
    // the Archive, a Daily for fun), "all", or "off". It also needs the secret PC_REFEREE_KEY.
    "PC_REFEREE": "practice"
  }
}
