// The answer counter and AI referee. See the "Answer counts" and "AI referee" sections of the main README.
{
  "name": "fihllion-counts",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fihllion",
      "database_id": "b600079c-daa2-43f3-9a5b-6051ca3b5948",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "DATA_URL": "https://mgwebstudio.github.io/Fihllion/data/",
    "ALLOWED_ORIGINS": "https://mgwebstudio.github.io",
    // Model calls allowed per day. Each costs about 2-3 of the 10,000 free daily "neurons".
    "AI_DAILY_CAP": "3000"
  }
}
