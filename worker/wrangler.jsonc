// The answer counter and AI referee. See the "Answer counts" and "AI referee" sections of the main README.
{
  "name": "fihllion-counts",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fihllion",
      "database_id": "b600079c-daa2-43f3-9a5b-6051ca3b5948",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "DATA_URL": "https://mgwebstudio.github.io/Fihllion/data/",
    "ALLOWED_ORIGINS": "https://mgwebstudio.github.io",
    // The referee's daily AI budget in Cloudflare's units ("neurons"), out of 10,000 free a day.
    // A call costs about 2.6, so this is about 3,700 calls. Practice stops AI_RANKED_RESERVE units
    // sooner, keeping about 750 calls for ranked. See the top of worker/src/shared.js.
    "AI_DAILY_UNITS": "9800",
    "AI_RANKED_RESERVE": "2000",
    // Until this time, practice may use the ranked reserve too. Nov 19, 2026 at 5 PM Mountain Time,
    // when that day's budget resets. Leave it in the past (or remove it) to keep the reserve.
    "AI_RESERVE_OFF_UNTIL": "2026-11-20T00:00:00Z"
  }
}
